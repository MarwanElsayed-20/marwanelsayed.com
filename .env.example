# Copy to .env.local for local work. Never commit real values; .env* is git-ignored
# (this example file is the only one that is tracked).
# On Vercel, set these in Project Settings -> Environment Variables instead.

# The public address of the site: https only, no path, no trailing slash.
# Drives canonical links, social share images, the sitemap and robots.
# Set for Production on Vercel. Leave empty locally; the build still works without it.
SITE_URL=

# Local review only: set to "true" to expose the /design-system review pages.
# Never set this in Production (those pages return 404 there regardless).
ENABLE_REVIEW_PAGES=

# Supplied automatically by Vercel (production, preview, development). Do not set it by hand.
# VERCEL_ENV=

# Contact form delivery (Resend, https://resend.com). Server-only; never prefix with NEXT_PUBLIC_.
# Without RESEND_API_KEY the form tells the visitor honestly that nothing was sent and shows the
# email address instead. Set these for Production (and Preview if you want to test there).
RESEND_API_KEY=
# Where messages are delivered. Defaults to the public contact email in src/content/site/contact.ts.
CONTACT_TO_EMAIL=
# The sender. Must be on a domain verified in Resend. The default, "<name> <onboarding@resend.dev>",
# is Resend's sandbox sender and only delivers to the email address of the Resend account owner.
CONTACT_FROM_EMAIL=

# The owner's dashboard (dash.marwanelsayed.com). Each message is also sent there, which stores it
# and notifies the owner's phone. Same value as INGEST_SECRET in the dashboard project.
DASHBOARD_INGEST_URL=
DASHBOARD_INGEST_SECRET=
