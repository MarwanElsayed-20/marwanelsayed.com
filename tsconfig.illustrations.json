{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".illustrations-build",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["scripts/illustrations/*.ts"]
}
